{
  "name": "@veyanet/mcp",
  "version": "1.2.3",
  "description": "VEYA MCP - Streamable HTTP Model Context Protocol for Robinhood Chain (testnet 46630)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veyanet/veya-mcp.git"
  },
  "homepage": "https://mcp.veyanet.tech/mcp",
  "bugs": {
    "url": "https://github.com/veyanet/veya-mcp/issues"
  },
  "bin": {
    "veya-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "tsx scripts/verify-full.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@veyanet/sdk": "^1.2.4",
    "cors": "^2.8.5",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.29",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "veya",
    "mcp",
    "model-context-protocol",
    "robinhood-chain",
    "streamable-http"
  ]
}
