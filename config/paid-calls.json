        "amount": "10000",
        "maxTimeoutSeconds": 1200,
        "feePayer": "CjNFTjvBhbJJd2B5ePPMHRLx1ELZpa8dwQgGL727eKww"
      }
    },
    {
      "id": "tokens.asset-risk-summary",
      "provider": "provider-1",
      "payer": "x402-exact",
      "url": "https://api.xona-agent.com/tokens-api/asset-risk-summary",
      "method": "POST",
      "description": "Risk score summary for a canonical asset (for example \"solana\" or \"usdc\"): score, grade, trust flags.",
      "input": {
        "required": [
          "assetId"
        ],
        "optional": [
          "mint"
        ],
        "properties": {
          "assetId": "slug",
          "mint": "solana-address"
        }
      },
      "expectedResult": {
        "httpStatus": 200,
        "requiredFields": [
          "success"
        ],
        "successValue": true
      },
