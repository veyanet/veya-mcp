# VEYA MCP (Streamable HTTP) — Robinhood Chain testnet 46630
PORT=8788
HOST=0.0.0.0
PUBLIC_MCP_URL=https://mcp.veyanet.tech/mcp

# Chain (read tools work with these alone)
ROBINHOOD_NETWORK=testnet
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
VEYA_CONTRACT_ADDRESS=0x1a1Dc3c55550FCE9F70ef6cDEeF967c0b72a5d84

# Optional: public API for guest stamp / verify convenience
VEYA_API_URL=https://api.veyanet.tech

# Write tools (storeCommitment / attestExecution / registerEnvironment)
# Require Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
VEYA_RELAYER_PRIVATE_KEY=

# CORS allowlist (comma-separated). Empty = reject browser Origin with credentials.
CORS_ORIGIN=https://veyanet.tech,https://www.veyanet.tech,https://app.veyanet.tech

# Honesty: NODE_ENV=production never invents quorum
NODE_ENV=development
