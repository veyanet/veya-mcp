# VEYA MCP (Streamable HTTP)
# Unset ROBINHOOD_NETWORK selects Mainnet.
# Production default is Mainnet. Testnet only when ROBINHOOD_NETWORK=testnet is set explicitly.
PORT=8788
HOST=0.0.0.0
# Always advertise the public paste URL on landing/health
PUBLIC_MCP_URL=https://mcp.veyanet.tech/mcp

# Mainnet (production default)
ROBINHOOD_NETWORK=mainnet
# ROBINHOOD_MAINNET_CHAIN_ID=4663
# ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_MAINNET_EXPLORER_URL=https://robinhoodchain.blockscout.com
# VEYA_MAINNET_CONTRACT_ADDRESS=0x87dC582eEA544A434a5C1e30Ca3d12c1e548a674
# VEYA_MAINNET_RELAYER_PRIVATE_KEY=
# VEYA_SEAL_DECISION_RELAYER=0
# VEYA_SEAL_DECISION_ENVIRONMENT_ID=
# VEYA_SEAL_DECISION_DAILY_CAP=20
# VEYA_SEAL_DECISION_GLOBAL_DAILY_CAP=100

# Testnet: only when set explicitly. Uncomment all lines below and remove ROBINHOOD_NETWORK=mainnet above.
# ROBINHOOD_NETWORK=testnet
# ROBINHOOD_CHAIN_ID=46630
# ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# VEYA_CONTRACT_ADDRESS=0x1a1Dc3c55550FCE9F70ef6cDEeF967c0b72a5d84

# Product API (guest sessions, registry, rooms)
VEYA_API_URL=https://api.veyanet.tech

# Your wallet for on-chain writes (user-funded). Prefer this over a tool argument.
# VEYA_PAYER_PRIVATE_KEY=

# When set, POST/GET/DELETE /mcp and /mcp/session require Authorization: Bearer <this value>.
# Leave empty to keep the public paste URL open. This is not the chain host signer key.
MCP_API_KEY=
VEYA_RELAYER_PRIVATE_KEY=

# Fleet: point at backend / product-API fleet URLs in production.
# Consensus validators are owned by the API — do not document private loopback as the public path.
# VEYA_VALIDATOR_NODES=
# VEYA_SEALED_NODE_URL=

CORS_ORIGIN=https://veyanet.tech,https://www.veyanet.tech,https://app.veyanet.tech
NODE_ENV=production
